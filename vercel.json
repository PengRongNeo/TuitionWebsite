{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tuition-pioneer.com" }],
      "destination": "https://www.tuitionatpioneer.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tuition-pioneer.com" }],
      "destination": "https://www.tuitionatpioneer.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tuitionatpioneer.com" }],
      "destination": "https://www.tuitionatpioneer.com/:path*",
      "permanent": true
    },
    {
      "source": "/locations/jurong-west",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/locations/jurong-west/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|school-logos/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
